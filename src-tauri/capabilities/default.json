{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认权限配置 - 授权所有自定义命令和插件，允许内置HTTP服务器origin访问IPC",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": ["http://127.0.0.1:18080", "http://localhost:18080"]
  },
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "fs:default",
    "dialog:default",
    "allow-all-commands"
  ]
}
